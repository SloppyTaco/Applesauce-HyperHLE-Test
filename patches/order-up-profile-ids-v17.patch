+const PROFILE_ROWS: usize = 24;
+const PROFILE_ROW_SIZE: usize = 0xca0;
+const PROFILE_SIZE: usize = 0x1302c;
+
+#[derive(Clone)]
+struct ProfileIdentity {
+    manager: u32,
+    profile: u32,
+    // The original initializer supplies both the IDs and their row locations.
+    // Definition order alone is not sufficient to establish a save-row mapping.
+    rows: Vec<(usize, u32)>,
+    definitions: Vec<(u32, u32)>,
+}
+
+fn capture_profile_identity(env: &mut Environment, slide: u32) {
+    let manager = word(env, slide + 0x656a70);
+    let profile = word(env, slide + 0x656a74);
+    let count = word(env, manager.saturating_add(8));
+    let entries = word(env, manager.saturating_add(4));
+    if !valid(env, manager, 0x218)
+        || word(env, manager) != slide + 0x66ae6c
+        || !valid(env, profile, PROFILE_SIZE as u32)
+        || !(1..=16).contains(&count)
+        || !valid(env, entries, count * 4)
+    {
+        log!("[ORDER UP PROFILE v17] Native ID capture skipped: invalid manager/profile.");
+        return;
+    }
+    let mut rows = Vec::new();
+    let mut definitions = Vec::new();
+    let mut identifiers = HashSet::new();
+    let mut locations = HashSet::new();
+    for index in 0..count {
+        let object = word(env, entries + index * 4);
+        if !valid(env, object, 0x4c8) { return; }
+        let identifier = word(env, object + 0x18);
+        let pointer = word(env, object + 0x4c4);
+        let Some(offset) = pointer.checked_sub(profile) else { return; };
+        let row = offset as usize / PROFILE_ROW_SIZE;
+        if identifier == 0 || row >= PROFILE_ROWS
+            || offset as usize % PROFILE_ROW_SIZE != 0
+            || word(env, pointer) != identifier
+            || !identifiers.insert(identifier) || !locations.insert(row)
+        {
+            log!("[ORDER UP PROFILE v17] Native ID capture skipped: definition={} id=0x{:x} row_pointer=0x{:x} stored_id=0x{:x}",
+                index, identifier, pointer, word(env, pointer));
+            return;
+        }
+        rows.push((row, identifier));
+        definitions.push((object, identifier));
+    }
+    log!("[ORDER UP PROFILE v17] Captured {} original initialized restaurant IDs in profile=0x{:x}; flags/progress untouched.", rows.len(), profile);
+    env.libc_state.order_up.profile_identity = Some(ProfileIdentity {
+        manager, profile, rows, definitions,
+    });
+}
+
+// A legacy save can overwrite the initialized table with zero identifiers.
+// Restore only the identity words, and only when every restaurant ID is zero.
+// Never set purchase bits, reset a row, or replay the destructive initializer.
+fn restore_profile_ids(profile: &mut [u8], rows: &[(usize, u32)]) -> bool {
+    if profile.len() != PROFILE_SIZE || rows.is_empty() || rows.len() > 16 {
+        return false;
+    }
+    let mut identifiers = HashSet::new();
+    let mut locations = HashSet::new();
+    if rows.iter().any(|&(row, identifier)| row >= PROFILE_ROWS || identifier == 0
+        || !identifiers.insert(identifier) || !locations.insert(row))
+    {
+        return false;
+    }
+    if (0..PROFILE_ROWS).any(|row| {
+        let at = row * PROFILE_ROW_SIZE;
+        profile[at..at + 4] != [0; 4]
+    }) {
+        return false;
+    }
+    for &(row, identifier) in rows {
+        let at = row * PROFILE_ROW_SIZE;
+        profile[at..at + 4].copy_from_slice(&identifier.to_le_bytes());
+    }
+    true
+}
+
+fn recover_profile_identity(env: &mut Environment, slide: u32) {
+    let Some(identity) = env.libc_state.order_up.profile_identity.clone() else {
+        return;
+    };
+    if word(env, slide + 0x656a70) != identity.manager
+        || word(env, slide + 0x656a74) != identity.profile
+        || word(env, identity.manager + 8) as usize != identity.definitions.len()
+        || identity.definitions.iter().any(|&(object, identifier)| {
+            word(env, object + 0x18) != identifier
+        })
+    {
+        return;
+    }
+    let profile = env.mem.bytes_at_mut(
+        MutPtr::from_bits(identity.profile), PROFILE_SIZE as u32,
+    );
+    if restore_profile_ids(profile, &identity.rows) {
+        env.libc_state.order_up.identity_recoveries += 1;
+        log!("[ORDER UP PROFILE v17] Restored {} original IDs after an all-zero table overwrite (recovery={}); purchase flags, coins, chef and day progress unchanged.",
+            identity.rows.len(), env.libc_state.order_up.identity_recoveries);
+    }
+}
