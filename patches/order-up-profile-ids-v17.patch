+#[cfg(test)]
+mod profile_identity_tests {
+    use super::{restore_profile_ids, PROFILE_ROWS, PROFILE_ROW_SIZE, PROFILE_SIZE};
+
+    fn legacy_profile() -> Vec<u8> {
+        // Keep recognizable nonzero chef, day, money, and restaurant progress.
+        let mut bytes: Vec<_> = (0..PROFILE_SIZE)
+            .map(|index| ((index * 37 + 19) % 251) as u8).collect();
+        for row in 0..PROFILE_ROWS {
+            bytes[row * PROFILE_ROW_SIZE..row * PROFILE_ROW_SIZE + 4].fill(0);
+        }
+        bytes
+    }
+
+    #[test]
+    fn restores_native_ids_without_changing_any_progress_or_purchase_flag() {
+        let rows = [(0, 0x12345678), (2, 0xf789083e), (7, 0x87654321)];
+        let mut profile = legacy_profile();
+        let before = profile.clone();
+        assert!(restore_profile_ids(&mut profile, &rows));
+        for (index, (&old, &new)) in before.iter().zip(&profile).enumerate() {
+            if let Some(&(row, identifier)) = rows.iter().find(|&&(row, _)| {
+                (row * PROFILE_ROW_SIZE..row * PROFILE_ROW_SIZE + 4).contains(&index)
+            }) {
+                assert_eq!(new, identifier.to_le_bytes()[index - row * PROFILE_ROW_SIZE]);
+            } else {
+                assert_eq!(new, old, "unexpected change at profile byte {index:#x}");
+            }
+        }
+        // Re-entering the shop must leave an already repaired table alone.
+        let repaired = profile.clone();
+        assert!(!restore_profile_ids(&mut profile, &rows));
+        assert_eq!(profile, repaired);
+    }
+
+    #[test]
+    fn refuses_partial_or_existing_profiles_including_unused_rows() {
+        for row in [0, 2, 23] {
+            let mut profile = legacy_profile();
+            profile[row * PROFILE_ROW_SIZE..row * PROFILE_ROW_SIZE + 4]
+                .copy_from_slice(&0xaabbccdd_u32.to_le_bytes());
+            let before = profile.clone();
+            assert!(!restore_profile_ids(&mut profile, &[(2, 0xf789083e)]));
+            assert_eq!(profile, before);
+        }
+    }
+
+    #[test]
+    fn rejects_ambiguous_native_mappings_without_a_partial_write() {
+        for rows in [vec![], vec![(0, 0)], vec![(24, 1)],
+            vec![(0, 1), (0, 2)], vec![(0, 1), (1, 1)],
+            (0..17).map(|row| (row, row as u32 + 1)).collect()]
+        {
+            let mut profile = legacy_profile();
+            let before = profile.clone();
+            assert!(!restore_profile_ids(&mut profile, &rows));
+            assert_eq!(profile, before);
+        }
+    }
+
+    #[test]
+    fn rejects_wrong_profile_lengths_without_writing() {
+        for length in [0, PROFILE_ROW_SIZE, PROFILE_SIZE - 1, PROFILE_SIZE + 1] {
+            let mut profile = vec![0; length];
+            assert!(!restore_profile_ids(&mut profile, &[(0, 1)]));
+            assert_eq!(profile, vec![0; length]);
+        }
+    }
+}
