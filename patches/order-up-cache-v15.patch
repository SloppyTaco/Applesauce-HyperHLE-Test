--- /dev/null
+++ b/src/order_up_cache.rs
@@ -0,0 +1,185 @@
+// Order Up!! 1.0 cache repair. Called only after executable verification.
+// Accept the supplied archive by its exact digest, decode it on the host,
+// and validate Chef.wad before changing the game's persistent cache.
+use crate::fs::{Fs, GuestPath};
+use sevenz_rust::{Password, SevenZReader};
+use sha2::{Digest, Sha256};
+use std::io::{Cursor, Read};
+
+const PACKAGE_SHA256: &str = "4803003a568c0e3d0ce4132378902dfce966dfde57935aacf6cd719528f28f85";
+const WAD_SHA256: &str = "662041f674c65c3d3323207cf680a58be19eeb1a0d4864ff2750de5a4dfa7ccb";
+const WAD_SIZE: usize = 49_023_680;
+const MAX_UNPACKED: usize = 53_000_000;
+
+fn digest(data: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(data))
+}
+
+fn asset_name(name: &str) -> bool {
+    (name == "Chef.wad" || name.starts_with("streams/"))
+        && !name.contains(['\\', '\0'])
+        && name.split('/').all(|part| !matches!(part, "" | "." | ".."))
+}
+
+fn decode(package: Vec<u8>) -> Result<Vec<(String, Vec<u8>)>, String> {
+    if digest(&package) != PACKAGE_SHA256 {
+        return Err("unrecognized source archive; existing cache retained".into());
+    }
+    let len = package.len() as u64;
+    let mut archive = SevenZReader::new(Cursor::new(package), len, Password::empty())
+        .map_err(|error| error.to_string())?;
+    let mut assets = Vec::new();
+    let mut total = 0usize;
+    archive
+        .for_each_entries(|entry, reader| {
+            if entry.is_directory {
+                return Ok(true);
+            }
+            if !asset_name(entry.name()) || entry.size() > MAX_UNPACKED as u64 {
+                return Err(sevenz_rust::Error::other("unexpected asset entry"));
+            }
+            total = total
+                .checked_add(entry.size() as usize)
+                .filter(|&sum| sum <= MAX_UNPACKED)
+                .ok_or_else(|| sevenz_rust::Error::other("asset size limit exceeded"))?;
+            let mut bytes = Vec::with_capacity(entry.size() as usize);
+            reader.take(entry.size() + 1).read_to_end(&mut bytes)?;
+            if bytes.len() as u64 != entry.size() {
+                return Err(sevenz_rust::Error::other("incomplete asset entry"));
+            }
+            if assets.iter().any(|(name, _)| name == entry.name()) {
+                return Err(sevenz_rust::Error::other("duplicate asset entry"));
+            }
+            assets.push((entry.name().to_owned(), bytes));
+            Ok(true)
+        })
+        .map_err(|error| error.to_string())?;
+    let wad = assets
+        .iter()
+        .find(|(name, _)| name == "Chef.wad")
+        .ok_or("Chef.wad missing from archive")?;
+    if wad.1.len() != WAD_SIZE || digest(&wad.1) != WAD_SHA256 {
+        return Err("decoded Chef.wad does not match the original".into());
+    }
+    Ok(assets)
+}
+
+pub(crate) fn prepare(fs: &mut Fs, bundle_path: &GuestPath) -> Result<(), String> {
+    let cache_dir = fs.home_directory().join("Library/Caches");
+    let cache = cache_dir.join("Chef.wad");
+    let old = match fs.read(&cache) {
+        Ok(bytes) => Some(bytes),
+        Err(()) if !fs.exists(&cache) => None,
+        Err(()) => return Err("existing cache is unreadable; repair stopped".into()),
+    };
+    let old_digest = old.as_deref().map(digest);
+    log!(
+        "[ORDER UP CACHE v15] Chef.wad bytes={} sha256={}",
+        old.as_ref().map_or(0, Vec::len),
+        old_digest.as_deref().unwrap_or("missing")
+    );
+    if old.is_none() {
+        log!("[ORDER UP CACHE v15] No existing cache; leaving first extraction to the game.");
+        return Ok(());
+    }
+    if old.as_ref().is_some_and(|bytes| bytes.len() == WAD_SIZE)
+        && old_digest.as_deref() == Some(WAD_SHA256)
+    {
+        log!("[ORDER UP CACHE v15] Original cache verified; no repair needed.");
+        return Ok(());
+    }
+    drop(old);
+    let package = fs
+        .read(bundle_path.join("data_iph_wad/chef_v1b.pkg"))
+        .map_err(|_| "source archive unavailable; existing cache retained")?;
+    let assets = decode(package)?;
+    let staging = fs.home_directory().join("tmp/orderup-cache-v15");
+    fs.create_dir_all(&staging)
+        .map_err(|error| format!("staging directory: {error:?}"))?;
+    fs.create_dir_all(&cache_dir)
+        .map_err(|error| format!("cache directory: {error:?}"))?;
+
+    // Stage all required writes before publishing Chef.wad. Supply any
+    // missing audio streams too, while retaining existing streams.
+    let mut staged = Vec::new();
+    for (name, bytes) in &assets {
+        let destination = cache_dir.join(name);
+        if name != "Chef.wad" && fs.exists(&destination) {
+            continue;
+        }
+        let temporary = staging.join(name);
+        let parent = temporary.parent().ok_or("invalid staging path")?;
+        fs.create_dir_all(parent)
+            .map_err(|error| format!("staging parent: {error:?}"))?;
+        fs.write(&temporary, bytes)
+            .map_err(|_| "unable to stage asset")?;
+        // Detect incomplete storage writes before replacing the old cache.
+        if fs
+            .read(&temporary)
+            .map_err(|_| "unable to verify staged asset")?
+            != *bytes
+        {
+            return Err("staged asset verification failed; existing cache retained".into());
+        }
+        staged.push((name.as_str(), temporary, destination));
+    }
+    for (name, temporary, destination) in &staged {
+        if *name == "Chef.wad" {
+            continue;
+        }
+        fs.create_dir_all(destination.parent().ok_or("invalid stream path")?)
+            .map_err(|error| format!("stream parent: {error:?}"))?;
+        fs.rename(temporary.as_ref(), destination.as_ref())
+            .map_err(|_| "unable to publish missing stream")?;
+    }
+    let (_, temporary, _) = staged
+        .iter()
+        .find(|(name, _, _)| *name == "Chef.wad")
+        .ok_or("Chef.wad not staged")?;
+    let backup =
+        old_digest.map(|hash| cache_dir.join(&format!("Chef.wad.v15-backup-{}", &hash[..16])));
+    if let Some(backup) = &backup {
+        fs.rename(cache.as_ref(), backup.as_ref())
+            .map_err(|_| "unable to preserve old cache; repair stopped")?;
+    }
+    if fs.rename(temporary.as_ref(), cache.as_ref()).is_err() {
+        if let Some(backup) = &backup {
+            let _ = fs.rename(backup.as_ref(), cache.as_ref());
+        }
+        return Err("unable to publish Chef.wad; attempted rollback".into());
+    }
+    log!("[ORDER UP CACHE v15] Restored original Chef.wad bytes={} sha256={} missing_streams={}; previous cache preserved={}",
+        WAD_SIZE, WAD_SHA256, staged.len() - 1, backup.is_some());
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn archive_paths_cannot_escape_cache() {
+        for name in ["Chef.wad", "streams/bgm_diner02.stm.iph.caf"] {
+            assert!(asset_name(name));
+        }
+        for name in [
+            "../Chef.wad",
+            "/Chef.wad",
+            "streams/../profile",
+            "streams//audio",
+            "streams/./audio",
+            "streams/a\\b",
+            "streams/a\0b",
+        ] {
+            assert!(!asset_name(name));
+        }
+    }
+
+    #[test]
+    fn unrecognized_archive_is_rejected_before_decoding() {
+        assert!(decode(Vec::new())
+            .unwrap_err()
+            .contains("unrecognized source"));
+        assert!(decode(b"not the original archive".to_vec()).is_err());
+    }
+}
