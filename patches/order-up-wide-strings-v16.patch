+// Observe the game's original ownership table; never change purchase state.
+fn purchase_snapshot(env: &Environment, slide: u32, phase: &str, candidate_id: u32) {
+    let manager = word(env, slide + 0x656a70);
+    let profile = word(env, slide + 0x656a74);
+    let count = word(env, manager.saturating_add(8));
+    let entries = word(env, manager.saturating_add(4));
+    if !valid(env, manager, 0x218)
+        || word(env, manager) != slide + 0x66ae6c
+        || !valid(env, profile, 0x12f04)
+        || count > 16 || !valid(env, entries, count * 4)
+    {
+        return;
+    }
+    log!("[ORDER UP PURCHASE v16] phase={} candidate_id=0x{:x} count={} profile=0x{:x}",
+        phase, candidate_id, count, profile);
+    for index in 0..count {
+        let object = word(env, entries + index * 4);
+        let row = profile + index * 0xca0;
+        let identifier = word(env, row);
+        let flags = word(env, row + 4);
+        // Profile rows are matched by ID in the guest, not by definition index.
+        log!("[ORDER UP OWNERSHIP v16] phase={} row={} id=0x{:x} flags=0x{:x} purchased={}",
+            phase, index, identifier, flags, flags & 2 != 0);
+        log!("[ORDER UP DEFINITION v16] phase={} index={} object=0x{:x} name={:?}",
+            phase, index, object, text(env, word(env, object.saturating_add(0x14))));
+    }
+}
