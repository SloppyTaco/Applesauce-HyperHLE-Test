+// Darwin wchar_t is a 32-bit scalar. Reading it as a C byte string
+// truncates ASCII names at the zero byte after their first character.
+fn wide_string_field(
+    mem: &Mem,
+    source: ConstPtr<wchar_t>,
+    precision: Option<usize>,
+    wide_output: bool,
+) -> Vec<u8> {
+    if source.is_null() {
+        let bytes = b"(null)";
+        return bytes[..precision.unwrap_or(bytes.len()).min(bytes.len())].to_vec();
+    }
+    let mut bytes = Vec::new();
+    let mut index = 0;
+    loop {
+        let length = if wide_output { index as usize } else { bytes.len() };
+        if precision.is_some_and(|limit| length >= limit) {
+            break;
+        }
+        let value = mem.read(source + index);
+        if value == 0 {
+            break;
+        }
+        let character = char::from_u32(value as u32).unwrap_or('\u{FFFD}');
+        let mut encoded = [0; 4];
+        let encoded = character.encode_utf8(&mut encoded).as_bytes();
+        if !wide_output
+            && precision.is_some_and(|limit| bytes.len() + encoded.len() > limit)
+        {
+            break;
+        }
+        bytes.extend_from_slice(encoded);
+        index += 1;
+    }
+    bytes
+}
 
